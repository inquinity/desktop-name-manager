#!/usr/bin/env bash
set -euo pipefail
# Print the state of the working tree, for the build stamp and the release recipe:
#   clean         nothing uncommitted (new files that are not ignored count as uncommitted)
#   build-number  the only change is the CURRENT_PROJECT_VERSION line in Version.xcconfig, which every
#                 `just build` moves forward (scripts/build-stamp.sh --bump); it is not a code change
#   dirty         anything else
repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

changes="$(git -C "$repository_root" status --porcelain)"
if [[ -z "$changes" ]]; then
    printf 'clean\n'
    exit 0
fi
# Anything other than a modified Version.xcconfig (staged or not) is a real change.
if [[ ! "$changes" =~ ^(M\ |\ M|MM)\ Version\.xcconfig$ ]]; then
    printf 'dirty\n'
    exit 0
fi
# Both the staged and the unstaged change (each against HEAD) must touch only the build number, and move it
# forward: a lower number would let a build or a release reuse one.
build_number_only() {
    local diff_lines old_number new_number
    diff_lines="$(git -C "$repository_root" diff --no-color --no-ext-diff --unified=0 "$@" -- Version.xcconfig \
        | grep -E '^[-+]' | grep -vE '^(\+\+\+|---) ' || true)"
    [[ -z "$diff_lines" ]] && return 0
    printf '%s\n' "$diff_lines" | grep -qvE '^[-+]CURRENT_PROJECT_VERSION = [0-9]+$' && return 1
    old_number="$(printf '%s\n' "$diff_lines" | sed -nE 's/^-CURRENT_PROJECT_VERSION = ([0-9]+)$/\1/p')"
    new_number="$(printf '%s\n' "$diff_lines" | sed -nE 's/^\+CURRENT_PROJECT_VERSION = ([0-9]+)$/\1/p')"
    [[ "$old_number" =~ ^[0-9]+$ && "$new_number" =~ ^[0-9]+$ ]] && ((new_number > old_number))
}
if build_number_only HEAD && build_number_only --cached HEAD; then
    printf 'build-number\n'
else
    printf 'dirty\n'
fi
